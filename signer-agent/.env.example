# Legacy single-share service configuration; not the new three-DKG bootstrap.
# For new participants use docs/CROSS_PLATFORM_QUICKSTART.md, own identity and
# the encrypted states generated by setup/flow. Do not paste DKG shares here.
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_SENDER=0x0000000000000000000000000000000000000000
EVM_PRIVATE_KEY=replace-me
FROST_COORDINATOR_ADDRESS=0x0000000000000000000000000000000000000000
FROST_ABI_PATH=./contracts/FROSTCoordinator.json
FROST_DEPLOYMENT_BLOCK=replace-with-deployment-block
FROST_SCAN_CHUNK_SIZE=5000

# Raw 32-byte Shamir signing scalar, not a serialized frost-core SecretShare.
FROST_SIGNING_SHARE_HEX=replace-with-64-hex-characters

SIGNER_STATE_KEY=replace-with-at-least-32-random-bytes
SIGNER_STATE_PATH=./.state/signer-state.enc
# Assert the independent nonce ledger initialized for this fresh state.
# SIGNER_NONCE_LEDGER=/mnt/private-ledger/signer.spent.sqlite

AUTO_SIGN=false
AUTO_FINALIZE=true
SIGNER_POLL_INTERVAL=30
EVM_CONFIRMATIONS=1
EVM_RECEIPT_TIMEOUT=180
PRIORITY_FEE_GWEI=2
# MAX_FEE_GWEI=30
# GAS_LIMIT=0
