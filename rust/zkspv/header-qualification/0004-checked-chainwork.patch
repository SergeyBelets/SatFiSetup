+
+/// Reject an unrepresentable cumulative work value instead of saturating it.
+fn checked_chainwork(total_work: [u8; 32], work_add: &U256) -> Result<[u8; 32], ValidationError> {
+    Option::<U256>::from(U256::from_be_bytes(total_work).checked_add(work_add))
+        .map(|value| value.to_be_bytes())
+        .ok_or(ValidationError::ChainworkOverflow)
 }
 
