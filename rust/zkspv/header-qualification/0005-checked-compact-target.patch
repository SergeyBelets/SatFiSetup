+/// Validate Core SetCompact/DeriveTarget range rules before target arithmetic.
+/// Reference: Bitcoin Core ee42d59d4de970769ebabf77b89ff4269498f61e,
+/// arith_uint256::SetCompact and DeriveTarget (MIT; notices retained separately).
+fn checked_target(bits: u32, pow_limit: U256) -> Result<[u8; 32], ValidationError> {
+    let size = bits >> 24;
+    let mut word = bits & 0x007fffff;
+    if size <= 3 {
+        word >>= 8 * (3 - size);
+    }
+    let negative = word != 0 && (bits & 0x00800000) != 0;
+    let overflow = word != 0
+        && (size > 34 || (word > 0xff && size > 33) || (word > 0xffff && size > 32));
+    if negative || word == 0 || overflow {
+        return Err(ValidationError::InvalidBlockBits);
+    }
+    // The existing decoder is now called only with a positive, representable
+    // target. Its shift count cannot reach 256 on this path.
+    let target = bits_to_target(bits);
+    if U256::from_be_bytes(target) > pow_limit {
+        return Err(ValidationError::InvalidBlockBits);
+    }
+    Ok(target)
 }
 
