+
+fn limits() -> [[u8; 32]; 4] {
+    [
+        U256::from_be_hex("00000000ffff0000000000000000000000000000000000000000000000000000").to_be_bytes(),
+        U256::from_be_hex("00000377ae000000000000000000000000000000000000000000000000000000").to_be_bytes(),
