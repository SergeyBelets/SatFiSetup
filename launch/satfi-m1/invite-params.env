# satfi-m1 invitation parameters (single source for the operator's `setup invite`).
# Values still marked TODO must be decided before the invitation is built.

# Deployment fee per federation and per confederation, in minimal units of the
# reward token. USDC has 6 decimals: 1000000 = 1 USDC. Paid by the operator to
# the project treasury; must be a positive integer (bootstrap_policy.validate).
DEPLOYMENT_FEE_AMOUNT=1000000
DEPLOYMENT_FEE_TREASURY=0x46CbF0964BCE33B818BC08e9224bEC1e99e9496A

# Reward token: USDC on Ethereum mainnet (test tokens are rejected).
REWARD_TOKEN_DECIMALS=6
REWARD_TOKEN=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
REWARD_TOKEN_CODE_HASH=0xd80d4b7c890cb9d6a4893e6b52bc34b56b25335cb13716e0d1d31383e6b41505  # keccak(runtime code) of the USDC proxy, read 2026-11-27

# FundedFeeConverter inventory, minimal units of the reward token: 3000000 = 3 USDC.
# Withdrawable only by the deployer (operator). Top up when real fee volume appears.
CONVERTER_FUNDING=3000000
# Fixed converter quote: reward units out = IMP units in * NUMERATOR / DENOMINATOR.
# 1 sat = 1e10 IMP units, so 1/1e10 = 0.000001 USDC per sat = 100 USDC per BTC (configurator default, anti-arbitrage).
CONVERTER_NUMERATOR=1
CONVERTER_DENOMINATOR=10000000000

# Public launch files.
TOKEN_METADATA=launch/satfi-m1/token-metadata.json
BITCOIN_POLICY=launch/satfi-m1/bitcoin-policy.json
DEPLOYMENT_ID=satfi-m1

# Invitation treasury (--treasury): project share of wrap/unwrap fees; bound into all three
# FROST ceremony manifests, so it cannot change without a new ceremony.
TREASURY=0x46CbF0964BCE33B818BC08e9224bEC1e99e9496A

# Wrap/unwrap fees of BTCY in basis points (50 = 0.5%) and DAO staker share (10000 = 100%).
WRAP_FEE_BPS=50
UNWRAP_FEE_BPS=50
WRAP_STAKER_BPS=10000
DEPLOY_STAKER_BPS=10000

# Bitcoin confirmations required for a deposit.
BITCOIN_CONFIRMATIONS=6

# Recipient of the 10M ULR minted by the first ceremony; distributed manually.
DAO_TOKEN_RECIPIENT=0x46CbF0964BCE33B818BC08e9224bEC1e99e9496A

# Income model: TODO (legacy = fees reach DAO only via the fixed-quote converter in USDC;
# in-kind = fees reach DAO directly in BTCY). See docs/CONFEDERATION_DAO_IN_KIND.md.
INCOME_MODEL=TODO
