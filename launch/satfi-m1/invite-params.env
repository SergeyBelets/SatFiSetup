# satfi-m1 invitation parameters (single source for the operator's `setup invite`).
# Values still marked TODO must be decided before the invitation is built.

# Deployment fee per federation and per confederation, in minimal units of the
# reward token. USDC has 6 decimals: 1000000 = 1 USDC. Paid by the operator to
# the project treasury; must be a positive integer (bootstrap_policy.validate).
DEPLOYMENT_FEE_AMOUNT=1000000
DEPLOYMENT_FEE_TREASURY=TODO

# Reward token (external stablecoin on chain 1; test tokens are rejected).
REWARD_TOKEN_DECIMALS=6
REWARD_TOKEN=TODO
REWARD_TOKEN_CODE_HASH=TODO

# FundedFeeConverter inventory, minimal units of the reward token.
CONVERTER_FUNDING=TODO

# Public launch files.
TOKEN_METADATA=launch/satfi-m1/token-metadata.json
BITCOIN_POLICY=launch/satfi-m1/bitcoin-policy.json
DEPLOYMENT_ID=satfi-m1
