# systemd user unit for the SatoshiFi monitoring reporter.
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp tools/satoshifi-report.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now satoshifi-report
#   loginctl enable-linger "$USER"     # keep running after logout
[Unit]
Description=SatoshiFi monitoring reporter
After=network-online.target

[Service]
ExecStart=%h/satfi-sdk/signer-agent/.venv/bin/python %h/satfi-sdk/tools/satoshifi_api.py report --config %h/.satoshifi/report.json --stage ceremony
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
