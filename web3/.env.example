# Chain Settings
CHAIN_ID=11155111
GAS_PRICE=auto
GAS_LIMIT=8000000

# Custodian DAO deployment: explicit addresses on the selected network.
# A completed, active confederation must already exist.
CONFEDERATION_FACTORY=
CONFEDERATION_ID=
DAO_REWARD_TOKEN=
BTC_USD_CHAINLINK_FEED=
DAO_TOKEN_NAME=
DAO_TOKEN_SYMBOL=
DAO_TOKEN_RECIPIENT=
# Set explicitly to true or false.
DAO_USE_RESERVE=

# Per-source adapter deployment (after the DAO graph exists).
DAO_INCOME_VAULT=
DAO_ADAPTER_KIND=
DAO_SOURCE_NAME=
DAO_SOURCE_STREAM=
# Supply the fields required by the selected adapter kind.
DAO_CLAIM_PROTOCOL=
DAO_SILO_VAULT=
DAO_INPUT_TOKEN=
DAO_CONVERTER=
DAO_LIQUIDITY_GUARD=
DAO_MINIMUM_LIQUIDITY=

# DeployFederation infrastructure preflight. Full system: docs/FIRST_DKG_ONCHAIN.md.
EXPECTED_CHAIN_ID=11155111
